{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Organizador",
  "version": "1.0.0",
  "identifier": "com.organizador.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Organizador",
        "width": 1360,
        "height": 860,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "decorations": false,
        "visible": false,
        "resizable": true,
        "dragDropEnabled": true,
        "backgroundColor": "#0B0F17"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": { "allow": ["**"], "deny": [] }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Organizador",
    "copyright": "© 2026 Organizador",
    "category": "Utility",
    "shortDescription": "Explorador de arquivos com foco em limpeza e otimização",
    "longDescription": "Organizador é um explorador de arquivos para Windows focado em organização, limpeza e otimização do computador. Funciona totalmente off-line.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "languages": ["PortugueseBR"],
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/nsis-header.bmp",
        "sidebarImage": "icons/nsis-sidebar.bmp",
        "startMenuFolder": "Organizador"
      }
    }
  }
}
